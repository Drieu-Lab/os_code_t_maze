# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Build / IDE artifacts
build/
dist/
.vscode/
.idea/

# Recorded session data (rig_logger.py raw log + phase3_controller.py session CSV)
host/data/

# Camera recordings + sidecars (experiment_control.py / camera_view.py output)
host/recordings/

# Records Manager GUI pref (the operator-picked recordings folder; a machine
# path, so per-machine not versioned - see docs/decisions/0088).
host/records_manager.json

# Learned appearance models (per-animal .npz; binary, kept in external backup).
# The per-rig GEOMETRY files (roi_polygon/landmarks/zones/rig_scale) are now
# VERSIONED as fixed rig parameters - see docs/decisions/0072 (supersedes the
# gitignore in ADR-0014/0018/0023/0025).
host/ratmodels/

# Compiled unit-test binaries (firmware/.../test)
test_task_core
test_task_core.exe

# Obsidian per-machine config for the capture-inbox vault (docs/notes/). The
# Markdown notes are versioned; Obsidian's local workspace/app config is not.
# see docs/decisions/0033
docs/notes/.obsidian/

# Jupyter checkpoints (auto-saved beside host/notebooks/*.ipynb; the notebooks
# themselves are versioned, this per-edit scratch copy is not).
.ipynb_checkpoints/

# Generated grant-figure PNGs (reproducible from proposal_figures.ipynb; the
# notebook + its tmaze.analysis code are versioned, the rendered images are not).
# see docs/decisions/0128
host/notebooks/grant_figures/outputs/

# Anaconda / anaconda-project local scratch (per-machine tool state DB).
anaconda_projects/

# OS cruft
.DS_Store
Thumbs.db
